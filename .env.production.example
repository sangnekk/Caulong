# Mẫu cấu hình cho máy chủ production. Sao chép thành .env trên máy chủ rồi điền giá trị.
# Không commit .env thật; mọi giá trị bí mật dưới đây đều để trống.
# Hướng dẫn triển khai: docs/production.md.

APP_NAME="Shop Cầu Lông"
# production làm SEO bật, debug tắt và 2FA của nhân viên được bắt buộc (xem các biến SHOP_* bên dưới).
APP_ENV=production
# Tắt stack trace và chi tiết cấu hình khi có lỗi. Không bật lại trên production.
APP_DEBUG=false
# Địa chỉ công khai của shop (Next.js), KHÔNG phải cổng 8000 của Laravel.
APP_URL=https://your-domain.example
# Cùng địa chỉ công khai; dùng cho canonical, sitemap và liên kết trong email.
FRONTEND_URL=https://your-domain.example
# Để trống rồi chạy "php artisan key:generate" trên máy chủ. Không dùng lại APP_KEY của máy local.
# Đổi APP_KEY sau khi đã có dữ liệu mã hóa (2FA, session) sẽ làm dữ liệu đó không đọc được.
APP_KEY=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# MySQL 8. Tạo database và user riêng, chỉ cấp quyền trên database của shop.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caulong
DB_USERNAME=caulong
# Mật khẩu mạnh, chỉ lưu trong .env (quyền 600) và trình quản lý bí mật; không commit.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie phiên chỉ gửi qua HTTPS. Bật khi chứng chỉ TLS đã chạy; nếu site còn HTTP, đăng nhập sẽ hỏng.
SESSION_SECURE_COOKIE=true
# Mã hóa nội dung phiên trong database; đổi giá trị này sẽ đăng xuất mọi người.
SESSION_ENCRYPT=true
# Lax chặn cookie trong request cross-site, đủ cho luồng đăng nhập/thanh toán hiện tại.
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/

# Session, cache và queue dùng chung MySQL; phải có tiến trình queue:work thường trực.
CACHE_STORE=database
QUEUE_CONNECTION=database

# Log xoay vòng theo ngày, giữ 14 ngày. Không đặt debug ở production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Gửi email thật qua Resend. RESEND_API_KEY là bí mật; MAIL_FROM_ADDRESS phải thuộc domain
# đã xác minh trên Resend (SPF + DKIM), không dùng địa chỉ Gmail.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Chỉ cho công cụ tìm kiếm lập chỉ mục sau khi domain thật đã chạy HTTPS và FRONTEND_URL đúng.
SHOP_SEO_INDEX=true
# Chặn quản trị viên chưa bật 2FA vào /admin; nhân viên tự bật tại /settings/security.
SHOP_REQUIRE_STAFF_TWO_FACTOR=true

# shop:backup chạy hằng ngày lúc 02:30 và xóa bản cũ hơn BACKUP_KEEP_DAYS ngày.
# Trên máy chủ nên đổi BACKUP_PATH thành đường dẫn tuyệt đối, ví dụ
# /var/www/bowfin/storage/backups, vì đường dẫn tương đối tính từ thư mục chạy lệnh.
BACKUP_KEEP_DAYS=14
BACKUP_PATH=storage/backups
# Chỉ cần khi mysqldump không có trong PATH.
# MYSQLDUMP_PATH=/usr/bin/mysqldump
