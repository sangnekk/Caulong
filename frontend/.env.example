# Where the Next.js server reaches Laravel (php artisan serve). Server-side only.
LARAVEL_URL=http://127.0.0.1:8000

NEXT_PUBLIC_APP_NAME="Shop Cầu Lông"

# Microsoft Clarity project id (clarity.microsoft.com > Settings > Overview). Empty: Clarity
# is never loaded. With an id, the store asks each visitor once and records only after a yes;
# sign-in, account settings and admin pages are never recorded. Read at build time.
NEXT_PUBLIC_CLARITY_ID=

# Set to 1 only when a reverse proxy (nginx, Caddy, a hosting platform) stands in front of this
# server and writes X-Forwarded-For, -Proto and -Host itself, replacing what the caller sent.
# Laravel then tells visitors apart by their address for its rate limits, and builds https links.
# Left empty, those headers are ignored: nobody can claim another address to get past a limit,
# and every visitor who is not signed in shares one allowance. Set it for the build and the run.
TRUST_PROXY=

# Development only. `next dev` serves its scripts to pages opened at localhost, 127.0.0.1 and
# this machine's network addresses (a phone on the same Wi-Fi). Any other host you open it
# from, such as a tunnel, goes here, comma-separated, without scheme or port.
DEV_ORIGINS=
