# Where the Next.js server reaches Laravel (php artisan serve). Server-side only.
LARAVEL_URL=http://127.0.0.1:8000

# Must match Laravel's session cookie name and SESSION_LIFETIME (minutes):
# proxy.ts keeps the cookie alive while the visitor browses server-rendered pages.
LARAVEL_SESSION_COOKIE=shop-cau-long-session
LARAVEL_SESSION_LIFETIME=120

NEXT_PUBLIC_APP_NAME="Shop Cầu Lông"
