# Where the Next.js server reaches Laravel (php artisan serve). Server-side only.
LARAVEL_URL=http://127.0.0.1:8000

NEXT_PUBLIC_APP_NAME="Shop Cầu Lông"

# Microsoft Clarity project id (clarity.microsoft.com > Settings > Overview). Empty: Clarity
# is never loaded. With an id, the store asks each visitor once and records only after a yes;
# sign-in, account settings and admin pages are never recorded. Read at build time.
NEXT_PUBLIC_CLARITY_ID=
