{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm --prefix frontend run dev",
        "build": "npm --prefix frontend run build",
        "start": "npm --prefix frontend run start",
        "check": "oxfmt --check && oxlint",
        "check:fix": "oxfmt && oxlint --fix",
        "types:check": "npm --prefix frontend run types:check",
        "routes": "php artisan wayfinder:generate --path=frontend/src --with-form"
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
