APP_NAME="Shop Cầu Lông"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Địa chỉ khách mở trong trình duyệt, tức app Next.js trong frontend/ (không phải cổng của Laravel).
APP_URL=http://localhost:3000
FRONTEND_URL="${APP_URL}"
# Công cụ tìm kiếm chỉ được lập chỉ mục khi APP_ENV=production; ở mọi môi trường khác robots.txt
# chặn toàn bộ và mọi trang có "noindex". Đặt true hoặc false ở đây để quyết định thay.
# SHOP_SEO_INDEX=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true # Bắt buộc khi production chạy HTTPS

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" chỉ ghi email vào storage/logs/laravel.log. Gửi thật qua Resend: MAIL_MAILER=resend,
# điền RESEND_API_KEY và đặt MAIL_FROM_ADDRESS thuộc domain đã xác minh trên Resend.
MAIL_MAILER=log
# RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
