{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "vendor/**",
        "node_modules/**",
        "public/**",
        "frontend/.next/**",
        "frontend/next-env.d.ts",
        "frontend/src/actions/**",
        "frontend/src/components/ui/*",
        "frontend/src/routes/**",
        "frontend/src/wayfinder/**"
    ],
    "options": {
        "denyWarnings": true,
        "typeAware": true
    }
}
